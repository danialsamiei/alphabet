{
  "name": "@alphabet/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Microbenchmarks for Alphabet core hot paths (signal collection, enrichment, decision engine, route normalization, consent policy, layer selection).",
  "scripts": {
    "benchmark": "node --import tsx/esm ./run-all.ts",
    "benchmark:smoke": "node --import tsx/esm ./run-all.ts --smoke",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alphabet/core": "workspace:*",
    "@alphabet/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tinybench": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0"
  }
}
