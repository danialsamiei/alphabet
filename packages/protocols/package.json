{
  "name": "@alphabet/protocols",
  "version": "1.0.0",
  "description": "Protocol adapters for the Alphabet SDK. Normalizes context, consent, memory permissions, and UI adaptation signals across Direct REST, Model Context Protocol (MCP), Agent-to-Agent (A2A), and AES-GCM-encrypted QR handoff — without bundling any LLM provider SDK. Provider-neutral by design.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./direct-api": {
      "types": "./dist/direct-api/index.d.ts",
      "import": "./dist/direct-api.js",
      "require": "./dist/direct-api.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a.js",
      "require": "./dist/a2a.cjs"
    },
    "./qr-handoff": {
      "types": "./dist/qr-handoff/index.d.ts",
      "import": "./dist/qr-handoff.js",
      "require": "./dist/qr-handoff.cjs"
    },
    "./normalizers": {
      "types": "./dist/normalizers/index.d.ts",
      "import": "./dist/normalizers.js",
      "require": "./dist/normalizers.cjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk.js",
      "require": "./dist/ai-sdk.cjs"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2.js",
      "require": "./dist/v2.cjs"
    },
    "./v2/providers": {
      "types": "./dist/v2/providers/index.d.ts",
      "import": "./dist/v2-providers.js",
      "require": "./dist/v2-providers.cjs"
    },
    "./v2/sdk": {
      "types": "./dist/v2/sdk/index.d.ts",
      "import": "./dist/v2-sdk.js",
      "require": "./dist/v2-sdk.cjs"
    },
    "./v2/consent-proof": {
      "types": "./dist/v2/consent-proof/index.d.ts",
      "import": "./dist/v2-consent-proof.js",
      "require": "./dist/v2-consent-proof.cjs"
    },
    "./v2/privacy": {
      "types": "./dist/v2/privacy/index.d.ts",
      "import": "./dist/v2-privacy.js",
      "require": "./dist/v2-privacy.cjs"
    },
    "./v2/compression": {
      "types": "./dist/v2/compression/index.d.ts",
      "import": "./dist/v2-compression.js",
      "require": "./dist/v2-compression.cjs"
    },
    "./v2/pulse": {
      "types": "./dist/v2/pulse/index.d.ts",
      "import": "./dist/v2-pulse.js",
      "require": "./dist/v2-pulse.cjs"
    },
    "./v2/xr": {
      "types": "./dist/v2/xr/index.d.ts",
      "import": "./dist/v2-xr.js",
      "require": "./dist/v2-xr.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@alphabet/core": "workspace:*",
    "@alphabet/api": "workspace:*"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
