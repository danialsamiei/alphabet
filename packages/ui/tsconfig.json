{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@awaf/core": ["../core/dist/index.d.ts"],
      "@awaf/api": ["../api/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"],
  "references": [
    { "path": "../core" },
    { "path": "../api" }
  ]
}
