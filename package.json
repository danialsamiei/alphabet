{
  "name": "@alphabet/sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "benchmark": "pnpm --filter @alphabet/benchmarks benchmark",
    "benchmark:smoke": "pnpm --filter @alphabet/benchmarks benchmark:smoke",
    "size": "size-limit",
    "size:check-r3f-free": "node scripts/check-ui-r3f-free.mjs",
    "bundle:visualize": "node scripts/bundle-visualizer.mjs",
    "changelog:aggregate": "node scripts/aggregate-changelog.mjs",
    "openapi:lint": "redocly lint openapi/alphabet.v1.yaml openapi/alphabet-protocol.v2.yaml",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.13.0",
    "@redocly/cli": "^1.25.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "size-limit": "^11.1.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
