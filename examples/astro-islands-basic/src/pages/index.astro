---
// src/pages/index.astro
// Host page: renders the Alphabet React island with client:load so Alphabet
// hydrates and runs its handshake immediately.
import AlphabetIsland from '../components/AlphabetIsland.tsx';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alphabet — Astro Islands basic</title>
  </head>
  <body>
    <main style="max-width:40rem;margin:2rem auto;font-family:system-ui,sans-serif;">
      <h1>Alphabet — Astro Islands basic</h1>
      <p>
        Alphabet picks a render layer from device capability and accessibility
        signals. DNT/GPC affect storage, not which layer is shown.
      </p>
      <AlphabetIsland client:load />
    </main>
  </body>
</html>
